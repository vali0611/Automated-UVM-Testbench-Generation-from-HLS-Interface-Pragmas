{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vivado Sim",
      "type": "shell",
      "command": "&",
      "args": [
        "${workspaceFolder}\\.vscode\\scripts\\run_all.bat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}